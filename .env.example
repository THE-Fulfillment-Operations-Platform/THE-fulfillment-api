# ---- App ----
APP_ENV=development
APP_NAME=THE Fulfillment API
PORT=8080

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=the_fulfillment
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Ho_Chi_Minh

# Connection pool. The defaults assume a REMOTE database (managed Postgres /
# pooler), where opening a connection costs a ~1s TCP+TLS+auth handshake and
# reusing a warm one costs a single round trip — so the pool is kept full and
# alive rather than trimmed. Only lower these if the database limits how many
# connections this service may hold.
# DB_MAX_OPEN_CONNS=15
# DB_MAX_IDLE_CONNS=15            # defaults to DB_MAX_OPEN_CONNS
# DB_CONN_MAX_LIFETIME_MINUTES=55
# DB_CONN_MAX_IDLE_MINUTES=30
# How often idle connections are pinged. Poolers and NAT gateways drop idle TCP
# sessions silently, so without this a "held" connection can still be dead and
# the next request pays the handshake. 0 disables the keepalive.
# DB_KEEPALIVE_SECONDS=60
# Server-side cap per SQL statement: a runaway query is cancelled by Postgres
# instead of pinning a pooled connection forever. Raise temporarily for heavy
# one-off migrations. 0 disables the cap.
# DB_STATEMENT_TIMEOUT_SECONDS=60

# ---- HTTP ----
# Largest accepted request body (uploads are parsed in memory, so this is also a
# memory-safety cap). Excel imports fit comfortably in the default.
# MAX_BODY_MB=32

# ---- Auth (JWT) ----
# Secret used to sign/verify JWTs. In production the server REFUSES to boot if
# this is left at the default or is shorter than 32 chars (a weak/known key lets
# anyone forge a token for any user). Generate one, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_EXPIRES_HOURS=72

# ---- CORS ----
# Comma-separated origins, or * to echo any origin (handy for local FE dev).
CORS_ALLOWED_ORIGINS=*

# ---- Seed ----
# Seed only bootstrap data on startup: the role catalog, a demo seller, and the
# demo login users. NO master catalog (materials/SKUs) or orders are ever seeded —
# that data comes from the real import/setup flows, so nothing reappears on restart.
SEED_ON_START=true
# Seed the demo login accounts (owner@the.local … with SEED_DEMO_PASSWORD). These
# are REAL working credentials — set false in production. In production the server
# refuses to boot if this is on while SEED_DEMO_PASSWORD is still the default.
SEED_DEMO_USERS=true
# Password assigned to every seeded demo user.
SEED_DEMO_PASSWORD=Password123!

# ---- Shipment tracking (24hTrack) ----
# Links each order to its parcel on https://www.24htrack.com and keeps the
# journey + status in sync. The integration authenticates with the DASHBOARD
# login (email/password), not an API key: an account holds only one active API
# key at a time, and only the dashboard API can find a parcel by its description
# — which is how a store order id maps to a tracking number.
TRACK24H_ENABLED=false
TRACK24H_BASE_URL=https://api.24htrack.com
TRACK24H_EMAIL=
TRACK24H_PASSWORD=
# Prefix written in front of the store order id in the provider's description
# field, e.g. "FFM:SO-1234". The provider account may be shared with other tools,
# so this is what tells our parcels apart. CHANGING IT ORPHANS every parcel that
# was already tagged with the old prefix.
TRACK24H_TAG=FFM
# How often the background sync runs, and how many parcels one pass refreshes.
# Each parcel costs up to 2 provider calls, and the provider allows 200/minute.
TRACK24H_SYNC_INTERVAL_MINUTES=20
TRACK24H_BATCH_SIZE=120
# Reverse lookup: for an order with no tracking number yet, ask the provider
# whether a parcel was registered under its store order id. Only finds anything
# once shipments are tagged that way (by us, or by whoever registers them).
TRACK24H_RESOLVE=true

# ---- Hiding the transport partner ------------------------------------------
# Towards the seller, we ARE the shipping company. Which partner physically
# carries the parcel is supplier information: the system stores no company name
# and never sends the provider's tracking page to a seller.
#
# One gap is left after that: the scan text the provider returns is free-form,
# and some partners stamp their own name into it ("Shipping Partner: …").
# List every spelling of that name here and it is replaced with SHIPPING_BRAND
# before any seller-facing response goes out. Case-insensitive; longer entries
# are matched first. Leave empty and nothing is rewritten.
#
# Keep the real names HERE, never in the source: this repository is handed to
# the customer, this file is not.
SHIPPING_PARTNER_ALIASES=
SHIPPING_BRAND=THE
