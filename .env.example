# ---- App ----
APP_ENV=development
APP_NAME=THE Fulfillment API
PORT=8080

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=the_fulfillment
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Ho_Chi_Minh

# Connection pool. The defaults assume a REMOTE database (managed Postgres /
# pooler), where opening a connection costs a ~1s TCP+TLS+auth handshake and
# reusing a warm one costs a single round trip — so the pool is kept full and
# alive rather than trimmed. Only lower these if the database limits how many
# connections this service may hold.
# DB_MAX_OPEN_CONNS=15
# DB_MAX_IDLE_CONNS=15            # defaults to DB_MAX_OPEN_CONNS
# DB_CONN_MAX_LIFETIME_MINUTES=55
# DB_CONN_MAX_IDLE_MINUTES=30
# How often idle connections are pinged. Poolers and NAT gateways drop idle TCP
# sessions silently, so without this a "held" connection can still be dead and
# the next request pays the handshake. 0 disables the keepalive.
# DB_KEEPALIVE_SECONDS=60
# Server-side cap per SQL statement: a runaway query is cancelled by Postgres
# instead of pinning a pooled connection forever. Raise temporarily for heavy
# one-off migrations. 0 disables the cap.
# DB_STATEMENT_TIMEOUT_SECONDS=60

# ---- HTTP ----
# Largest accepted request body (uploads are parsed in memory, so this is also a
# memory-safety cap). Excel imports fit comfortably in the default.
# MAX_BODY_MB=32

# ---- Auth (JWT) ----
# Secret used to sign/verify JWTs. In production the server REFUSES to boot if
# this is left at the default or is shorter than 32 chars (a weak/known key lets
# anyone forge a token for any user). Generate one, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_EXPIRES_HOURS=72

# ---- CORS ----
# Comma-separated origins, or * to echo any origin (handy for local FE dev).
CORS_ALLOWED_ORIGINS=*

# ---- Seed ----
# Seed only bootstrap data on startup: the role catalog, a demo seller, and the
# demo login users. NO master catalog (materials/SKUs) or orders are ever seeded —
# that data comes from the real import/setup flows, so nothing reappears on restart.
SEED_ON_START=true
# Seed the demo login accounts (owner@the.local … with SEED_DEMO_PASSWORD). These
# are REAL working credentials — set false in production. In production the server
# refuses to boot if this is on while SEED_DEMO_PASSWORD is still the default.
SEED_DEMO_USERS=true
# Password assigned to every seeded demo user.
SEED_DEMO_PASSWORD=Password123!

# ---- Danger zone ----
# Kill-switch for POST /api/admin/reset (OWNER only) — wipes all order/production
# data so the catalog can be re-imported from scratch. Works in any environment,
# including production, when true; the route is still guarded by the OWNER role
# and a typed confirmation. Set false to disable the feature entirely.
ALLOW_DATA_RESET=false
